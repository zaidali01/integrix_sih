# ArgusChain Node.js Backend Environment Variables

# Server Configuration
PORT=3000
JWT_SECRET=super_secret_jwt_key_for_hackathon

# Blockchain Configuration
RPC_URL=http://127.0.0.1:8545
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Contract Addresses (Replace after running Hardhat deploy script)
IDENTITY_NFT_ADDRESS=
ROLE_TOKEN_ADDRESS=
ASSET_NFT_ADDRESS=
ACCESS_BADGE_ADDRESS=

# Cloud Storage Configuration (AWS S3 or MinIO)
# For AWS S3:
# MINIO_ENDPOINT=s3.amazonaws.com
# MINIO_PORT=443
# MINIO_USE_SSL=true
# MINIO_ACCESS_KEY=your-aws-access-key-here
# MINIO_SECRET_KEY=your-aws-secret-key-here

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=arguschain-vault
